{
  "schema_version": "1.1",
  "capability_id": "lookup_savings_balance",
  "name": "Lookup Savings Balance",
  "description": "Find a member and return their current savings balance.",
  "application": "LegacyBank Credit Union",
  "start_url": "http://127.0.0.1:5001/",
  "parameters": [{"name": "member_id", "type": "string", "required": true, "description": "Member number to search for."}],
  "outputs": [{"name": "savings_balance", "type": "string", "description": "Current savings balance."}],
  "steps": [
    {"step_id": "step_1", "action": "click", "target": {"role": "link", "name": "Member Lookup", "selector": "a[aria-label=\"Member Lookup\"]"}, "value": null, "description": "Open Member Lookup."},
    {"step_id": "step_2", "action": "type", "target": {"role": "textbox", "name": "Member Number", "selector": "input[name=\"member_id\"]"}, "value": "{{member_id}}", "description": "Enter the member number."},
    {"step_id": "step_3", "action": "click", "target": {"role": "button", "name": "Search Member", "selector": "button[aria-label=\"Search Member\"]"}, "value": null, "description": "Submit the member lookup."},
    {"step_id": "step_4", "action": "extract", "target": null, "value": "Savings Balance", "output_name": "savings_balance", "description": "Extract the current savings balance."}
  ],
  "success_condition": {"type": "text_present", "value": "Member Details"}
}
